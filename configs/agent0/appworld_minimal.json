{
  "schema_version": 1,
  "upstream": "third_party/Agent0",
  "model": "Qwen/Qwen3-4B-Base",
  "data": {
    "train_files": "artifacts/appworld_train/agent0/train.parquet",
    "val_files": "artifacts/appworld_train/agent0/validation.parquet",
    "train_batch_size": 8,
    "val_batch_size": 8,
    "max_prompt_length": 2048,
    "max_response_length": 8192
  },
  "agent": {
    "tool_server_url": "http://127.0.0.1:5000/get_observation",
    "action_stop_tokens_file": "artifacts/appworld_train/agent0/tool_call_stop.txt",
    "max_obs_length": 2048,
    "max_turns": 40
  },
  "trainer": {
    "experiment_name": "agent0-appworld-minimal",
    "gpus": 1,
    "rollouts_per_task": 4,
    "mini_batch_size": 8,
    "learning_rate": 1e-6,
    "gpu_memory_utilization": 0.5,
    "save_freq": 20,
    "test_freq": 10,
    "total_training_steps": 100
  }
}

